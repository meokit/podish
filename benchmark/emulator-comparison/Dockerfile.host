FROM mcr.microsoft.com/dotnet/sdk:10.0-noble
ARG PODISH_UBUNTU_MIRROR
RUN if [ -n "$PODISH_UBUNTU_MIRROR" ]; then \
        sed -i -E "s#http://(archive|security)[.]ubuntu[.]com/ubuntu/?#$PODISH_UBUNTU_MIRROR#g" \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates clang-20 cmake curl file git libc++-20-dev libc++abi-20-dev \
    libsqlite3-dev ninja-build pkg-config python3 qemu-system-x86 qemu-user \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.91.1
ENV PATH=/root/.cargo/bin:$PATH CC=clang-20 CXX=clang++-20 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 CMAKE_GENERATOR=Ninja CMAKE_BUILD_PARALLEL_LEVEL=8
RUN ln -s /usr/bin/clang-20 /usr/local/bin/clang \
    && ln -s /usr/bin/clang++-20 /usr/local/bin/clang++
ARG PODISH_BENCH_COMMIT
ENV PODISH_BENCH_COMMIT=$PODISH_BENCH_COMMIT
WORKDIR /src
COPY . .
RUN dotnet publish Podish.Cli/Podish.Cli.csproj -c Release -o /opt/podish \
    -p:LlvmBlockJit=OFF \
    -p:DynamicInstructionSpecialization=OFF
ENTRYPOINT ["python3", "/src/benchmark/emulator-comparison/measure.py"]
