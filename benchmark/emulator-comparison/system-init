#!/bin/sh
# PID 1 for the CPU benchmark VM. The serial markers delimit the workload.
set -u
export LC_ALL=C LANG=C TZ=UTC UV_THREADPOOL_SIZE=1
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
mount -t proc proc /proc
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t sysfs sysfs /sys
bench_case=
bench_iterations=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        bench_case=*) bench_case=${arg#bench_case=} ;;
        bench_iterations=*) bench_iterations=${arg#bench_iterations=} ;;
    esac
done
cd /opt/bench
printf '\nBENCH_BEGIN\n'
( . ./system-cases.sh )
status=$?
printf '\nBENCH_END %s\n' "$status"
case "$bench_case" in
    gzip) sha256sum out/gzip.bin ;;
    sort) sha256sum out/sort.txt ;;
    gemm) sha256sum out/gemm.txt ;;
esac
printf 'BENCH_FINISHED\n'
exec /bin/busybox poweroff -f
