diff --git a/libfibercpu/src/ops/ops_shift_bit_impl.h b/libfibercpu/src/ops/ops_shift_bit_impl.h
index 5b4b4ae2..58d539c8 100644
--- a/libfibercpu/src/ops/ops_shift_bit_impl.h
+++ b/libfibercpu/src/ops/ops_shift_bit_impl.h
@@ -251,6 +251,35 @@ FORCE_INLINE LogicFlow OpGroup2_EvCl_Internal(LogicFuncParams) {
 
 namespace op {
 
+// Register-only immediate rotations: decoder-selected width and flag liveness.
+// The 5-bit masked count (not its modulo-width value) controls CF/OF updates.
+template <typename T, bool Right, bool UpdateFlags>
+FORCE_INLINE LogicFlow OpRotateRegImmediate(LogicFuncParams) {
+    const uint8_t rm = op->modrm & 7;
+    const uint32_t original = GetReg(state, rm);
+    const T value = static_cast<T>(original);
+    const uint8_t count = imm & 31;
+    const T result = Right ? std::rotr(value, count) : std::rotl(value, count);
+    if constexpr (UpdateFlags) {
+        if (count != 0) {
+            constexpr unsigned width = sizeof(T) * 8;
+            const bool cf = Right ? (result >> (width - 1)) & 1 : result & 1;
+            AssignCF(flags_cache, cf);
+            if (count == 1) {
+                const bool msb = (result >> (width - 1)) & 1;
+                const bool other = Right ? (result >> (width - 2)) & 1 : cf;
+                AssignOF(flags_cache, msb != other);
+            }
+        }
+    }
+    if constexpr (sizeof(T) == 2)
+        SetReg(state, rm, (original & 0xFFFF0000u) | result);
+    else
+        SetReg(state, rm, result);
+    return LogicFlow::Continue;
+}
+
+
 FORCE_INLINE LogicFlow OpGroup2_EbIb(LogicFuncParams) { return OpGroup2_EvIb_Internal<true>(LogicPassParams); }
 FORCE_INLINE LogicFlow OpGroup2_EvIb(LogicFuncParams) { return OpGroup2_EvIb_Internal<false>(LogicPassParams); }
 FORCE_INLINE LogicFlow OpGroup2_Eb1(LogicFuncParams) { return OpGroup2_Ev1_Internal<true>(LogicPassParams); }
diff --git a/Fiberish.X86.Tests/Integer/RegisterImmediateRotateTests.cs b/Fiberish.X86.Tests/Integer/RegisterImmediateRotateTests.cs
new file mode 100644
index 00000000..cbd223ac
--- /dev/null
+++ b/Fiberish.X86.Tests/Integer/RegisterImmediateRotateTests.cs
@@ -0,0 +1,50 @@
+using Fiberish.X86.Native;
+using Fiberish.X86.Tests.Harness;
+using Xunit;
+
+namespace Fiberish.X86.Tests.Integer;
+
+public sealed class RegisterImmediateRotateTests
+{
+    [Theory]
+    [InlineData(16, false, false)]
+    [InlineData(16, false, true)]
+    [InlineData(16, true, false)]
+    [InlineData(16, true, true)]
+    [InlineData(32, false, false)]
+    [InlineData(32, false, true)]
+    [InlineData(32, true, false)]
+    [InlineData(32, true, true)]
+    public void AllRegistersCountsFlagsAndDeadFlagForms(int width, bool right, bool flagsDead)
+    {
+        for (int register = 0; register < 8; register++)
+        {
+            using var cpu = new CpuSandbox();
+            foreach (int count in new[] { 0, 1, 2, 7, 8, 15, 16, 17, 31, 32, 33, 255 })
+            foreach (uint input in new[] { 0u, 1u, IntegerOracle.Sign(width), IntegerOracle.Mask(width), 0x95A53C69u })
+            foreach (bool set in new[] { false, true })
+            {
+                uint flags = IntegerOracle.InitialFlags(set);
+                uint[] expected = IntegerTestSupport.Initialize(cpu, flags);
+                var lane = width == 16 ? OperandLane.Ax : OperandLane.Eax;
+                expected[register] = IntegerOracle.PutLane(expected[register], lane, input);
+                cpu[(Reg)register] = expected[register];
+                var result = IntegerOracle.Shift(right ? ShiftOperation.Ror : ShiftOperation.Rol, width, input, (byte)count, flags);
+                expected[register] = IntegerOracle.PutLane(expected[register], lane, result.Value);
+                var code = new List<byte>();
+                if (width == 16) code.Add(0x66);
+                code.AddRange(new byte[] { 0xC1, (byte)(0xC0 | (right ? 8 : 0) | register), (byte)count });
+                if (flagsDead)
+                {
+                    int other = (register + 1) % 8;
+                    code.AddRange(new byte[] { 0x31, (byte)(0xC0 | (other << 3) | other) });
+                    expected[other] = 0;
+                }
+                string context = $"width={width} right={right} reg={register} count={count} input={input:X8} initial={flags:X8} dead={flagsDead}";
+                IntegerTestSupport.Execute(cpu, code.ToArray(), ExecutionMode.Run, context);
+                IntegerTestSupport.AssertRegisters(cpu, expected, context);
+                if (!flagsDead) IntegerTestSupport.AssertFlags(cpu, result.Flags, result.FlagMask, context);
+            }
+        }
+    }
+}
diff --git a/Fiberish.X86.Tests/Regression/SpecializedFusionBakingTests.cs b/Fiberish.X86.Tests/Regression/SpecializedFusionBakingTests.cs
new file mode 100644
index 00000000..df309070
--- /dev/null
+++ b/Fiberish.X86.Tests/Regression/SpecializedFusionBakingTests.cs
@@ -0,0 +1,82 @@
+using Fiberish.X86.Native;
+using Fiberish.X86.Tests.Harness;
+using Xunit;
+
+namespace Fiberish.X86.Tests.Regression;
+
+public sealed class SpecializedFusionBakingTests
+{
+    // SHR EAX/[EAX],3; MOV EDX,ESI; MOVZX EBX,byte[EDI+ESI*2]; MOV ECX,[EDI+ESI*2].
+    private static byte[] Code(bool memory) => [0xC1, memory ? (byte)0x28 : (byte)0xE8, 3,
+        0x89, 0xF2, 0x0F, 0xB6, 0x1C, 0x77, 0x8B, 0x0C, 0x77];
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void SpecializedRegisterAndGenericMemorySequencesKeepExactFusion(bool memory)
+    {
+        using var cpu = new CpuSandbox();
+        cpu[Reg.EAX] = memory ? CpuSandbox.DataAddress + 8 : 0x80;
+        cpu[Reg.ESI] = 0;
+        cpu[Reg.EDI] = CpuSandbox.DataAddress;
+        cpu.WriteMemory(CpuSandbox.DataAddress, BitConverter.GetBytes(0x1234567au));
+        cpu.WriteMemory(CpuSandbox.DataAddress + 8, BitConverter.GetBytes(0x80u));
+        var code = Code(memory);
+        cpu.WriteCode(code);
+        cpu.Run(CpuSandbox.CodeAddress + (uint)code.Length);
+        Assert.Equal(EmuStatus.Stopped, cpu.Status);
+        Assert.Equal(memory ? CpuSandbox.DataAddress + 8 : 0x10u, cpu[Reg.EAX]);
+        Assert.Equal(memory ? 0x10u : 0x80u,
+            BitConverter.ToUInt32(cpu.ReadMemory(CpuSandbox.DataAddress + 8, 4)));
+        Assert.Equal(0u, cpu[Reg.EDX]);
+        Assert.Equal(0x7au, cpu[Reg.EBX]);
+        Assert.Equal(0x1234567au, cpu[Reg.ECX]);
+        AssertHead(cpu, memory);
+    }
+
+    [Fact]
+    public void FaultInsideSpecializedFusionRestartsAtTheFaultWithoutRepeatingShift()
+    {
+        using var cpu = new CpuSandbox();
+        const uint unmapped = 0x50000000;
+        cpu[Reg.EAX] = 0x80;
+        cpu[Reg.ESI] = 0;
+        cpu[Reg.EDI] = unmapped;
+        var code = Code(false);
+        cpu.WriteCode(code);
+        cpu.Run(CpuSandbox.CodeAddress + (uint)code.Length);
+        Assert.Equal(EmuStatus.Fault, cpu.Status);
+        Assert.Equal(14, cpu.FaultVector);
+        Assert.Equal(CpuSandbox.CodeAddress + 5u, cpu.Eip);
+        Assert.Equal(0x10u, cpu[Reg.EAX]);
+        AssertHead(cpu, false);
+        cpu.MapMemory(unmapped, CpuSandbox.PageSize);
+        cpu.WriteMemory(unmapped, BitConverter.GetBytes(0x1234567au));
+        cpu.Run(CpuSandbox.CodeAddress + (uint)code.Length);
+        Assert.Equal(EmuStatus.Stopped, cpu.Status);
+        Assert.Equal(0x10u, cpu[Reg.EAX]);
+        Assert.Equal(0x7au, cpu[Reg.EBX]);
+        Assert.Equal(0x1234567au, cpu[Reg.ECX]);
+    }
+
+    private static unsafe void AssertHead(CpuSandbox cpu, bool memory)
+    {
+        // The functional and fault checks also run in the CI configuration
+        // that disables superopcodes; only the handler assertion needs fusion.
+        if ((X86Native.GetBuildFeatures() & 1) == 0) return;
+        int count = X86Native.GetBlockCount(cpu.State);
+        var blocks = new IntPtr[count];
+        fixed (IntPtr* p = blocks) X86Native.GetBlockList(cpu.State, p, count);
+        foreach (IntPtr p in blocks)
+        {
+            var b = (X86Native.BasicBlock*)p;
+            if (b->start_eip != CpuSandbox.CodeAddress) continue;
+            string symbol = X86Native.GetHandlerSymbolById(X86Native.GetHandlerId(b->entry))!;
+            Assert.Contains("SuperOpcode_4_", symbol);
+            if (memory) Assert.DoesNotContain("Shr_ModReg", symbol);
+            else Assert.Contains("Shr_ModReg", symbol);
+            return;
+        }
+        Assert.Fail("Root block not retained");
+    }
+}
