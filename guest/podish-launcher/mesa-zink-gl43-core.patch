+bool
+_mesa_validate_border_color(struct gl_context *ctx, double r, double g,
+                            double b, double a)
+{
+   if (!ctx->Const.PodishNoCustomBorderColor)
+      return true;
+
+   /* Vulkan's built-in transparent black, opaque black, and opaque white. */
+   if (r == g && r == b &&
+       ((r == 0 && (a == 0 || a == 1)) || (r == 1 && a == 1)))
+      return true;
+
+   _mesa_error(ctx, GL_INVALID_OPERATION, "custom texture border colors are unavailable");
+   return false;
+}
