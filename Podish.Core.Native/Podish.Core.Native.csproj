<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\Podish.Display\Podish.Display.csproj"/>
        <ProjectReference Include="..\Podish.Core\Podish.Core.csproj"/>
        <ProjectReference Include="..\Podish.Wayland\Podish.Wayland.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <AssemblyName>podishcore</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot Condition="'$(TargetFramework)' == 'net10.0'">true</PublishAot>
        <PublishAotUsingRuntimePack Condition="'$(TargetFramework)' == 'net10.0'">true</PublishAotUsingRuntimePack>
        <NativeLib Condition="'$(TargetFramework)' == 'net10.0'">Static</NativeLib>
        <SelfContained Condition="'$(TargetFramework)' == 'net10.0'">true</SelfContained>
        <StripSymbols Condition="'$(TargetFramework)' == 'net10.0'">false</StripSymbols>
        <InvariantGlobalization Condition="'$(TargetFramework)' == 'net10.0'">true</InvariantGlobalization>
        <PodishStaticNative>true</PodishStaticNative>
        <IsAotCompatible>true</IsAotCompatible>
        <PodishGraphicsBackend Condition="'$(PodishGraphicsBackend)' == ''">gles</PodishGraphicsBackend>
        <DefineConstants Condition="'$(PodishGraphicsBackend)' == 'vulkan'">$(DefineConstants);PODISH_APPLE_VULKAN</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="DesktopAngleRenderer.cs" Condition="'$(PodishGraphicsBackend)' == 'vulkan'"/>
        <Compile Remove="DesktopVulkanRenderer.cs" Condition="'$(PodishGraphicsBackend)' != 'vulkan'"/>
    </ItemGroup>

    <Target Name="ValidatePodishGraphicsBackend" BeforeTargets="CoreCompile"
            Condition="'$(PodishGraphicsBackend)' != 'vulkan' And '$(PodishGraphicsBackend)' != 'gles'">
        <Error Text="PodishGraphicsBackend must be vulkan or gles."/>
    </Target>

    <ItemGroup>
        <DirectPInvoke Include="fibercpu"/>
        <DirectPInvoke Include="fiberish_netstack"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.4"/>
    </ItemGroup>

</Project>
