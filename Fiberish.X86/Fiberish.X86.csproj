<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
        <IsBrowserWasm Condition="'$(RuntimeIdentifier)' == 'browser-wasm' Or '$(FiberishForceBrowserWasm)' == 'true'">true</IsBrowserWasm>

        <DefineConstants Condition="'$(IsBrowserWasm)' == 'true'">$(DefineConstants);FIBERISH_BROWSER_WASM</DefineConstants>
        <NativeBuildDir Condition="'$(IsBrowserWasm)' == 'true'">$(FibercpuWasmNativeBuildDir)</NativeBuildDir>
        <NativeBuildDir Condition="'$(IsBrowserWasm)' != 'true' And '$(RuntimeIdentifier)' != ''">build_native/$(RuntimeIdentifier)</NativeBuildDir>
        <NativeBuildDir Condition="'$(IsBrowserWasm)' != 'true' And '$(RuntimeIdentifier)' == ''">build_native/host</NativeBuildDir>
        <NativeBuildDir Condition="'$(IsBrowserWasm)' != 'true' And '$(FibercpuIsolatedPreset)' == 'true'">$(NativeBuildDir)/$(FibercpuResolvedBakingPreset)</NativeBuildDir>
        <NativeBuildDir Condition="'$(IsBrowserWasm)' != 'true'">$(NativeBuildDir)$(FibercpuGuestSuffix)</NativeBuildDir>
        <NativeBakingPreset>$(FibercpuResolvedBakingPreset)</NativeBakingPreset>
        <NativeBakingPreset Condition="'$(IsBrowserWasm)' == 'true'">$(FibercpuResolvedWasmBakingPreset)</NativeBakingPreset>
        <FusionStrategy Condition="'$(FusionStrategy)' == ''">AUTO</FusionStrategy>
        <OperandBudget Condition="'$(OperandBudget)' == ''">AUTO</OperandBudget>
        <PinSpecialization Condition="'$(PinSpecialization)' == ''">AUTO</PinSpecialization>
        <OperandPlanFile Condition="'$(OperandPlanFile)' == ''"></OperandPlanFile>
        <StaticInstructionSpecialization Condition="'$(StaticInstructionSpecialization)' == ''">ON</StaticInstructionSpecialization>
        <DynamicInstructionSpecialization Condition="'$(DynamicInstructionSpecialization)' == '' And '$(IsBrowserWasm)' == 'true'">OFF</DynamicInstructionSpecialization>
        <DynamicInstructionSpecialization Condition="'$(DynamicInstructionSpecialization)' == ''">ON</DynamicInstructionSpecialization>
        <LlvmBlockJit Condition="'$(LlvmBlockJit)' == ''">OFF</LlvmBlockJit>
        <GprPin Condition="'$(GprPin)' == '' And '$(IsBrowserWasm)' == 'true'">OFF</GprPin>
        <GprPin Condition="'$(GprPin)' == ''">AUTO</GprPin>
        <AArch64PinRegister Condition="'$(AArch64PinRegister)' == ''">-1</AArch64PinRegister>
        <GprPinRegisters Condition="'$(GprPinRegisters)' == ''">EAX,ESP</GprPinRegisters>
        <GprWriteBack Condition="'$(GprWriteBack)' == ''">ON</GprWriteBack>
        <SuperOpcodeTop Condition="'$(SuperOpcodeTop)' == ''">128</SuperOpcodeTop>
        <!-- Keep generated inputs outside the CMake tree: changing toolchains may recreate that tree. -->
        <SuperOpcodeGenerationDir>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(BaseIntermediateOutputPath)', 'superopcode'))</SuperOpcodeGenerationDir>
        <SuperOpcodeSource Condition="'$(SuperOpcodeManifest)' != '' And '$(SuperOpcodeSource)' == ''">$(SuperOpcodeGenerationDir)/superopcodes.generated.cpp</SuperOpcodeSource>
        <SuperOpcodeGeneratorDll>$(MSBuildThisFileDirectory)../Podish.PerfTools/bin/Release/net11.0/Podish.PerfTools.dll</SuperOpcodeGeneratorDll>
         <FibercpuWasmDownloadUrl Condition="'$(FibercpuWasmDownloadUrl)' == ''"></FibercpuWasmDownloadUrl>
         <LibFibercpuSourceDir>$(MSBuildThisFileDirectory)../libfibercpu</LibFibercpuSourceDir>
         <LibFibercpuSourceExists Condition="Exists('$(LibFibercpuSourceDir)/CMakeLists.txt')">true</LibFibercpuSourceExists>
         <LibFibercpuSourceExists Condition="'$(LibFibercpuSourceExists)' == ''">false</LibFibercpuSourceExists>
         <VsWhereExe Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
         <WindowsClangTargetArch Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">x64</WindowsClangTargetArch>
         <WindowsToolchainSignatureFile Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">$(NativeBuildDir)\.podish-toolchain</WindowsToolchainSignatureFile>
     </PropertyGroup>

    <ImportGroup Condition="'$(IsBrowserWasm)' == 'true' And '$(EmscriptenToolchainFile)' == ''">
        <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.Emscripten.Node.net11"/>
        <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.Emscripten.Sdk.net11"/>
        <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.Emscripten.Cache.net11"/>
    </ImportGroup>

    <PropertyGroup Condition="'$(IsBrowserWasm)' == 'true'">
        <EmscriptenToolchainFile Condition="'$(EmscriptenToolchainFile)' == ''">$([MSBuild]::NormalizePath('$(EmscriptenSdkToolsPath)', 'emscripten', 'cmake', 'Modules', 'Platform', 'Emscripten.cmake'))</EmscriptenToolchainFile>
        <BrowserWasmNodeSuffix Condition="$([MSBuild]::IsOsPlatform('Windows'))">.exe</BrowserWasmNodeSuffix>
        <BrowserWasmNodeExecutable Condition="'$(BrowserWasmNodeExecutable)' == '' And '$(EmscriptenNodeToolsPath)' != ''">$([MSBuild]::NormalizePath('$(EmscriptenNodeToolsPath)', 'bin', 'node$(BrowserWasmNodeSuffix)'))</BrowserWasmNodeExecutable>
        <BrowserWasmNodeExecutable Condition="'$(BrowserWasmNodeExecutable)' == ''">node</BrowserWasmNodeExecutable>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsBrowserWasm)' == 'true' And '$(EmscriptenSdkToolsPath)' != ''">
        <FibercpuEmscriptenEnvironment Include="DOTNET_EMSCRIPTEN_LLVM_ROOT=$([MSBuild]::NormalizePath('$(EmscriptenSdkToolsPath)', 'bin'))"/>
        <FibercpuEmscriptenEnvironment Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$([MSBuild]::NormalizePath('$(EmscriptenSdkToolsPath)'))"/>
        <FibercpuEmscriptenEnvironment Include="DOTNET_EMSCRIPTEN_NODE_JS=$(BrowserWasmNodeExecutable)"/>
        <FibercpuEmscriptenEnvironment Include="EM_CACHE=$(WasmCachePath)"/>
    </ItemGroup>

    <!-- Define inputs for incremental build tracking -->
    <ItemGroup Condition="'$(LibFibercpuSourceExists)' == 'true'">
        <NativeBuildInput Include="$(LibFibercpuSourceDir)/CMakeLists.txt" />
        <NativeBuildInput Include="$(LibFibercpuSourceDir)/cmake/**/*.cmake" />
        <NativeBuildInput Include="$(LibFibercpuSourceDir)/presets/**/*.json;$(LibFibercpuSourceDir)/presets/**/*.cpp" />
        <NativeBuildInput Include="$(MSBuildProjectFullPath)" />
        <NativeBuildInput Include="$(EmscriptenToolchainFile)" Condition="'$(IsBrowserWasm)' == 'true'" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/gen_operand_specializations.py" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/gen_instruction_catalog.py" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/gen_wasm_hot_dispatch.py" Condition="'$(IsBrowserWasm)' == 'true' And '$(WasmHotDispatchHandlers)' != '0'" />
        <NativeBuildInput Include="$(WasmHotDispatchPlan)" Condition="'$(IsBrowserWasm)' == 'true' And '$(WasmHotDispatchPlan)' != ''" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/scalar_modrm.py" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/check_native_text_budget.py" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/embed_llvm_bitcode.py" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/operand_specialization_data.py" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/gen_dynamic_operand_specializations.py" Condition="'$(DynamicOperandPlanFile)' != ''" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../scripts/operand_stencil_arm64.py" Condition="'$(DynamicOperandPlanFile)' != ''" />
        <NativeBuildInput Include="$(MSBuildThisFileDirectory)../benchmark/optimization/manifests/*" />
        <NativeBuildInput Include="$(SuperOpcodeGenerationDir)/native-options.txt" />
        <NativeBuildInput Include="$(LibFibercpuSourceDir)/src/**/*" />
        <NativeBuildInput Include="$(LibFibercpuSourceDir)/3rdparty/**/*" />
        <NativeBuildInput Include="$(AArch64OperandPlanFile)" Condition="'$(AArch64OperandPlanFile)' != ''" />
        <NativeBuildInput Include="$(OperandPlanFile)" Condition="'$(OperandPlanFile)' != ''" />
        <NativeBuildInput Include="$(DynamicOperandPlanFile)" Condition="'$(DynamicOperandPlanFile)' != ''" />
        <NativeBuildInput Include="$(SuperOpcodeSource)" Condition="'$(SuperOpcodeSource)' != ''" />
    </ItemGroup>

    <!-- Opt-in deterministic generation from reviewed data. No guest execution or
         network asset preparation occurs inside an ordinary native build. -->
    <Target Name="PrepareSuperOpcodeGenerator" BeforeTargets="GenerateSelectedSuperOpcodes"
            Condition="'$(SuperOpcodeManifest)' != '' And '$(DesignTimeBuild)' != 'true' And '$(FiberishSkipNativeBuild)' != 'true'">
        <Error Condition="'$(NativeBakingPreset)' != 'custom'" Text="SuperOpcodeManifest requires FibercpuBakingPreset=custom." />
        <Error Condition="'$(EnableSuperOpcodes)' == 'false'" Text="SuperOpcodeManifest cannot be used with EnableSuperOpcodes=false." />
        <Error Condition="!$([System.IO.Path]::IsPathRooted('$(SuperOpcodeManifest)'))" Text="SuperOpcodeManifest must be an absolute path." />
        <Error Condition="!Exists('$(SuperOpcodeManifest)')" Text="Missing locked SuperOpcodeManifest: $(SuperOpcodeManifest)" />
        <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../Podish.PerfTools/Podish.PerfTools.csproj&quot; -c Release --nologo" />
        <MakeDir Directories="$(SuperOpcodeGenerationDir)" />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SuperOpcodeSource)'))" />
        <WriteLinesToFile File="$(SuperOpcodeGenerationDir)/superopcode-options.txt" Lines="top=$(SuperOpcodeTop)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>
    <Target Name="GenerateSelectedSuperOpcodes" BeforeTargets="BuildNativeLib"
            Condition="'$(SuperOpcodeManifest)' != '' And '$(DesignTimeBuild)' != 'true' And '$(FiberishSkipNativeBuild)' != 'true'"
            Inputs="$(SuperOpcodeManifest);$(SuperOpcodeGeneratorDll);$(MSBuildProjectFullPath);$(SuperOpcodeGenerationDir)/superopcode-options.txt"
            Outputs="$(SuperOpcodeSource)">
        <Exec WorkingDirectory="$(MSBuildThisFileDirectory).."
              Command="dotnet &quot;$(SuperOpcodeGeneratorDll)&quot; gen-superopcodes --input &quot;$(SuperOpcodeManifest)&quot; --output &quot;$(SuperOpcodeSource)&quot; --top $(SuperOpcodeTop)" />
    </Target>

    <Target Name="PrepareNativeOptions" BeforeTargets="BuildNativeLib"
            Condition="'$(DesignTimeBuild)' != 'true' And '$(FiberishSkipNativeBuild)' != 'true'">
        <Error Condition="'$(NativeBakingPreset)' != 'custom' And '$(NativeBakingPreset)' != '1.5m' And '$(NativeBakingPreset)' != '3m' And '$(NativeBakingPreset)' != '10m'"
               Text="Unknown FibercpuBakingPreset '$(NativeBakingPreset)'. Choose custom, 1.5m, 3m or 10m." />
        <MakeDir Directories="$(SuperOpcodeGenerationDir)" />
        <WriteLinesToFile File="$(SuperOpcodeGenerationDir)/native-options.txt"
            Lines="i386=$(FiberGuestI386);aarch64=$(FiberGuestAArch64);aarch64_plan=$(AArch64OperandPlanFile);aarch64_pin=$(AArch64PinRegister);baking_preset=$(NativeBakingPreset);fusion=$(FusionStrategy);budget=$(OperandBudget);pin=$(GprPin);pins=$(GprPinRegisters);writeback=$(GprWriteBack);coverage=$(PinSpecialization);plan=$(OperandPlanFile);static=$(StaticInstructionSpecialization);dynamic=$(DynamicInstructionSpecialization);dynamic_plan=$(DynamicOperandPlanFile);llvm=$(LlvmBlockJit);llvm_dir=$(LlvmConfigDir);native_clang=$(NativeClangDir);super=$(EnableSuperOpcodes);source=$(SuperOpcodeSource);handler=$(EnableHandlerProfile);block=$(EnableBlockProfile);sequence=$(EnableSequenceProfile);wasm_hot_dispatch=$(WasmHotDispatchHandlers);wasm_hot_plan=$(WasmHotDispatchPlan)"
            Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="BuildNativeLib" BeforeTargets="BeforeBuild" 
            Condition="'$(DesignTimeBuild)' != 'true' And '$(FiberishSkipNativeBuild)' != 'true' And '$(LibFibercpuSourceExists)' == 'true'"
            Inputs="@(NativeBuildInput)"
            Outputs="$(NativeBuildDir)/Release/fibercpu.dll;$(NativeBuildDir)/Release/fibercpu.lib;$(NativeBuildDir)/libfibercpu.so;$(NativeBuildDir)/libfibercpu.a;$(NativeBuildDir)/libfibercpu.dylib">
        
        <PropertyGroup>
            <BuildFibercpuStatic Condition="'$(PublishAot)' == 'true' Or '$(PodishStaticNative)' == 'true' Or '$(IsBrowserWasm)' == 'true'">true</BuildFibercpuStatic>
            <BuildFibercpuStatic Condition="'$(BuildFibercpuStatic)' == ''">false</BuildFibercpuStatic>
            <CMakeArgs Condition="'$(BuildFibercpuStatic)' == 'true'">-DFIBERCPU_BUILD_STATIC=ON -DFIBERCPU_ENABLE_LTO=OFF</CMakeArgs>
            <CMakeArgs Condition="'$(BuildFibercpuStatic)' == 'true' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('ios'))">$(CMakeArgs) -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_ARCHITECTURES=arm64</CMakeArgs>
            <CMakeArgs Condition="'$(BuildFibercpuStatic)' == 'true' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('ios-'))">$(CMakeArgs) -DCMAKE_OSX_SYSROOT=iphoneos</CMakeArgs>
            <CMakeArgs Condition="'$(BuildFibercpuStatic)' == 'true' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))">$(CMakeArgs) -DCMAKE_OSX_SYSROOT=iphonesimulator</CMakeArgs>
            <CMakeArgs Condition="'$(BuildFibercpuStatic)' != 'true'">-DFIBERCPU_BUILD_STATIC=OFF</CMakeArgs>
            <CMakeArgs Condition="'$(IsBrowserWasm)' == 'true'">$(CMakeArgs) -DCMAKE_BUILD_TYPE=Release</CMakeArgs>
            <CMakeArgs Condition="'$(IsBrowserWasm)' != 'true' And $([MSBuild]::IsOsPlatform('Windows')) != 'true'">$(CMakeArgs) -DCMAKE_BUILD_TYPE=Release</CMakeArgs>
            <CMakeArgs Condition="$([MSBuild]::IsOsPlatform('OSX')) And '$(IsBrowserWasm)' != 'true' And '$(NativeClangDir)' == ''">$(CMakeArgs) -DCMAKE_C_COMPILER=/usr/bin/cc -DCMAKE_CXX_COMPILER=/usr/bin/c++</CMakeArgs>
            <CMakeArgs Condition="$([MSBuild]::IsOsPlatform('OSX')) And '$(NativeClangDir)' != ''">$(CMakeArgs) -DCMAKE_C_COMPILER=&quot;$(NativeClangDir)/clang&quot; -DCMAKE_CXX_COMPILER=&quot;$(NativeClangDir)/clang++&quot;</CMakeArgs>
            <CMakeArgs Condition="$([MSBuild]::IsOsPlatform('Linux')) And '$(IsBrowserWasm)' != 'true'">$(CMakeArgs) -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_CXX_FLAGS=-stdlib=libc++ -DCMAKE_SHARED_LINKER_FLAGS=-stdlib=libc++</CMakeArgs>
            
            <!-- CMake 4.1 on Windows does not yet expose a Visual Studio 2026 generator, so use Ninja Multi-Config
                 with the Visual Studio LLVM toolchain explicitly selected. -->
            <CMakeGeneratorArgs Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">-G "Ninja Multi-Config"</CMakeGeneratorArgs>
            
            <CMakeHandlerProfile Condition="'$(EnableHandlerProfile)' == 'true'">ON</CMakeHandlerProfile>
            <CMakeHandlerProfile Condition="'$(CMakeHandlerProfile)' == ''">OFF</CMakeHandlerProfile>
            <CMakeBlockProfile Condition="'$(EnableBlockProfile)' == 'true'">ON</CMakeBlockProfile>
            <CMakeBlockProfile Condition="'$(CMakeBlockProfile)' == ''">OFF</CMakeBlockProfile>
            <CMakeSuperOpcodes Condition="'$(EnableSuperOpcodes)' == 'false'">OFF</CMakeSuperOpcodes>
            <CMakeSuperOpcodes Condition="'$(CMakeSuperOpcodes)' == ''">ON</CMakeSuperOpcodes>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_ENABLE_HANDLER_PROFILE=$(CMakeHandlerProfile)</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_ENABLE_BLOCK_PROFILE=$(CMakeBlockProfile)</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_ENABLE_SUPEROPCODES=$(CMakeSuperOpcodes)</CMakeArgs>
            <CMakeSequenceProfile Condition="'$(EnableSequenceProfile)' == 'true'">ON</CMakeSequenceProfile>
            <CMakeSequenceProfile Condition="'$(CMakeSequenceProfile)' == ''">OFF</CMakeSequenceProfile>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_ENABLE_SEQUENCE_PROFILE=$(CMakeSequenceProfile)</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_GUEST_I386=$(FiberGuestI386) -DFIBERCPU_GUEST_AARCH64=$(FiberGuestAArch64) -DFIBERCPU_AARCH64_PIN_REG=$(AArch64PinRegister) -DFIBERCPU_AARCH64_OPERAND_PLAN_FILE=&quot;$(AArch64OperandPlanFile)&quot;</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_BAKING_PRESET=$(NativeBakingPreset)</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_FUSION_STRATEGY=$(FusionStrategy) -DFIBERCPU_OPERAND_BUDGET=$(OperandBudget) -DFIBERCPU_GPR_PIN=$(GprPin) -DFIBERCPU_GPR_PIN_REGISTERS=&quot;$(GprPinRegisters)&quot; -DFIBERCPU_GPR_WRITE_BACK=$(GprWriteBack) -DFIBERCPU_PIN_SPECIALIZATION=$(PinSpecialization) -DFIBERCPU_OPERAND_PLAN_FILE=&quot;$(OperandPlanFile)&quot;</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_GENERATED_SUPEROPCODES_FILE=&quot;$(SuperOpcodeSource)&quot;</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_DYNAMIC_OPERAND_PLAN_FILE=&quot;$(DynamicOperandPlanFile)&quot;</CMakeArgs>
            <CMakeArgs>$(CMakeArgs) -DFIBERCPU_STATIC_SPECIALIZATION=$(StaticInstructionSpecialization) -DFIBERCPU_ENABLE_DYNAMIC_SPECIALIZATION=$(DynamicInstructionSpecialization) -DFIBERCPU_ENABLE_LLVM_JIT=$(LlvmBlockJit)</CMakeArgs>
            <CMakeArgs Condition="'$(IsBrowserWasm)' == 'true'">$(CMakeArgs) -DFIBERCPU_WASM_HOT_DISPATCH_HANDLERS=$(WasmHotDispatchHandlers) -DFIBERCPU_WASM_HOT_DISPATCH_PLAN=&quot;$(WasmHotDispatchPlan)&quot;</CMakeArgs>
            <CMakeArgs Condition="'$(LlvmConfigDir)' != ''">$(CMakeArgs) -DLLVM_DIR=&quot;$(LlvmConfigDir)&quot;</CMakeArgs>
            <CMakeGeneratorArgs Condition="'$(IsBrowserWasm)' == 'true'">-G Ninja</CMakeGeneratorArgs>
            <CMakeArgs Condition="'$(IsBrowserWasm)' == 'true'">$(CMakeArgs) -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY -DCMAKE_TOOLCHAIN_FILE=&quot;$(EmscriptenToolchainFile)&quot; -DCMAKE_CROSSCOMPILING_EMULATOR=&quot;$(BrowserWasmNodeExecutable)&quot;</CMakeArgs>
        </PropertyGroup>

        <Message Text="Building libfibercpu with CMake (Incremental check passed)..." Importance="High"/>
        <Error Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And !Exists('$(VsWhereExe)')"
               Text="Could not locate vswhere.exe at $(VsWhereExe)." />
        <Exec Command="&quot;$(VsWhereExe)&quot; -latest -products * -property installationPath"
              ConsoleToMSBuild="true"
              StandardOutputImportance="Low"
              Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">
            <Output TaskParameter="ConsoleOutput" ItemName="_WindowsVsInstallDirOutput" />
        </Exec>
        <PropertyGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">
            <WindowsVisualStudioInstallDir>@(_WindowsVsInstallDirOutput->'%(Identity)')</WindowsVisualStudioInstallDir>
            <WindowsClangClPath Condition="Exists('$(WindowsVisualStudioInstallDir)\VC\Tools\Llvm\$(WindowsClangTargetArch)\bin\clang-cl.exe')">$(WindowsVisualStudioInstallDir)\VC\Tools\Llvm\$(WindowsClangTargetArch)\bin\clang-cl.exe</WindowsClangClPath>
            <WindowsClangClPath Condition="'$(WindowsClangClPath)' == '' And Exists('$(WindowsVisualStudioInstallDir)\VC\Tools\Llvm\bin\clang-cl.exe')">$(WindowsVisualStudioInstallDir)\VC\Tools\Llvm\bin\clang-cl.exe</WindowsClangClPath>
            <WindowsNinjaPath>$(WindowsVisualStudioInstallDir)\Common7\IDE\CommonExtensions\Microsoft\CMake\Ninja\ninja.exe</WindowsNinjaPath>
            <WindowsVsDevCmdPath>$(WindowsVisualStudioInstallDir)\Common7\Tools\VsDevCmd.bat</WindowsVsDevCmdPath>
            <WindowsNativeToolchainSignature>clangcl-ninja-mc|$(WindowsVisualStudioInstallDir)|$(WindowsClangClPath)|$(WindowsNinjaPath)</WindowsNativeToolchainSignature>
            <WindowsCMakeConfigureCommand>cmd /d /s /c &quot;&quot;$(WindowsVsDevCmdPath)&quot; -arch=$(WindowsClangTargetArch) -host_arch=$(WindowsClangTargetArch) &gt;nul &amp;&amp; cmake -S ../libfibercpu -B $(NativeBuildDir) $(CMakeGeneratorArgs) $(CMakeArgs) -DCMAKE_MAKE_PROGRAM=&quot;$(WindowsNinjaPath)&quot; -DCMAKE_C_COMPILER=&quot;$(WindowsClangClPath)&quot; -DCMAKE_CXX_COMPILER=&quot;$(WindowsClangClPath)&quot;&quot;</WindowsCMakeConfigureCommand>
            <WindowsCMakeBuildCommand>cmd /d /s /c &quot;&quot;$(WindowsVsDevCmdPath)&quot; -arch=$(WindowsClangTargetArch) -host_arch=$(WindowsClangTargetArch) &gt;nul &amp;&amp; cmake --build $(NativeBuildDir) --config Release&quot;</WindowsCMakeBuildCommand>
        </PropertyGroup>
        <Error Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And '$(WindowsVisualStudioInstallDir)' == ''"
               Text="Could not resolve a Visual Studio installation path via $(VsWhereExe)." />
        <Error Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And !Exists('$(WindowsClangClPath)')"
               Text="Could not locate clang-cl.exe under $(WindowsVisualStudioInstallDir)." />
        <Error Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And !Exists('$(WindowsNinjaPath)')"
               Text="Could not locate ninja.exe under $(WindowsVisualStudioInstallDir)." />
        <Error Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And !Exists('$(WindowsVsDevCmdPath)')"
               Text="Could not locate VsDevCmd.bat under $(WindowsVisualStudioInstallDir)." />
        <ReadLinesFromFile File="$(WindowsToolchainSignatureFile)"
                           Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And Exists('$(WindowsToolchainSignatureFile)')">
            <Output TaskParameter="Lines" ItemName="_ExistingWindowsToolchainSignature" />
        </ReadLinesFromFile>
        <PropertyGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'">
            <ExistingWindowsNativeToolchainSignature>@(_ExistingWindowsToolchainSignature->'%(Identity)')</ExistingWindowsNativeToolchainSignature>
        </PropertyGroup>
        <RemoveDir Directories="$(NativeBuildDir)"
                   Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true' And Exists('$(NativeBuildDir)') And '$(ExistingWindowsNativeToolchainSignature)' != '$(WindowsNativeToolchainSignature)'" />
        
        <MakeDir Directories="$(NativeBuildDir)" />
        <WriteLinesToFile File="$(WindowsToolchainSignatureFile)"
                          Lines="$(WindowsNativeToolchainSignature)"
                          Overwrite="true"
                          Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'" />
        <Exec Command="$(WindowsCMakeConfigureCommand)"
              WorkingDirectory="$(MSBuildThisFileDirectory)"
              Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'" />
        <Exec Command="cmake -S ../libfibercpu -B $(NativeBuildDir) $(CMakeGeneratorArgs) $(CMakeArgs)"
              WorkingDirectory="$(MSBuildThisFileDirectory)"
              EnvironmentVariables="@(FibercpuEmscriptenEnvironment)"
              Condition="$([MSBuild]::IsOsPlatform('Windows')) != 'true' Or '$(IsBrowserWasm)' == 'true'" />
        <Exec Command="$(WindowsCMakeBuildCommand)"
              WorkingDirectory="$(MSBuildThisFileDirectory)"
              Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(IsBrowserWasm)' != 'true'" />
        <Exec Command="cmake --build $(NativeBuildDir) --config Release"
              WorkingDirectory="$(MSBuildThisFileDirectory)"
              EnvironmentVariables="@(FibercpuEmscriptenEnvironment)"
              Condition="$([MSBuild]::IsOsPlatform('Windows')) != 'true' Or '$(IsBrowserWasm)' == 'true'" />
    </Target>

    <ItemGroup Condition="'$(IsBrowserWasm)' == 'true'">
        <NativeFileReference Include="$(NativeBuildDir)/libfibercpu.a"/>
    </ItemGroup>

    <ItemGroup Condition="('$(PublishAot)' == 'true' Or '$(PodishStaticNative)' == 'true') And '$(IsBrowserWasm)' != 'true' And $([MSBuild]::IsOsPlatform('OSX'))">
        <NativeLibrary Include="$(NativeBuildDir)/libfibercpu.a"/>
    </ItemGroup>

    <ItemGroup Condition="('$(PublishAot)' == 'true' Or '$(PodishStaticNative)' == 'true') And '$(IsBrowserWasm)' != 'true' And $([MSBuild]::IsOsPlatform('Linux'))">
        <NativeLibrary Include="$(NativeBuildDir)/libfibercpu.a"/>
    </ItemGroup>

    <ItemGroup Condition="('$(PublishAot)' == 'true' Or '$(PodishStaticNative)' == 'true') And '$(IsBrowserWasm)' != 'true' And $([MSBuild]::IsOsPlatform('Windows'))">
        <NativeLibrary Include="$(NativeBuildDir)/Release/fibercpu.lib"/>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOsPlatform('OSX')) And '$(PublishAot)' != 'true' And '$(PodishStaticNative)' != 'true' And '$(IsBrowserWasm)' != 'true'">
        <Content Include="$(NativeBuildDir)/libfibercpu.dylib">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>libfibercpu.dylib</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Linux')) And '$(PublishAot)' != 'true' And '$(PodishStaticNative)' != 'true' And '$(IsBrowserWasm)' != 'true'">
        <Content Include="$(NativeBuildDir)/libfibercpu.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>libfibercpu.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) And '$(PublishAot)' != 'true' And '$(PodishStaticNative)' != 'true' And '$(IsBrowserWasm)' != 'true'">
        <Content Include="$(NativeBuildDir)/Release/fibercpu.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>fibercpu.dll</Link>
        </Content>
    </ItemGroup>

</Project>
