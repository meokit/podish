<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Podish.Browser</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <UseMonoRuntime>false</UseMonoRuntime>
        <WasmBuildNative>true</WasmBuildNative>
        <WasmInitialHeapSize>536870912</WasmInitialHeapSize>
        <EmccStackSize>8MB</EmccStackSize>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PackageId>Podish.Browser</PackageId>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'RelWithDebInfo'">
        <WasmNativeDebugSymbols>true</WasmNativeDebugSymbols>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0"/>
    </ItemGroup>

    <PropertyGroup>
        <FibercpuWasmNativeDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '../Fiberish.X86', '$(FibercpuWasmNativeBuildDir)'))</FibercpuWasmNativeDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Podish.Core/Podish.Core.csproj" AdditionalProperties="FiberishForceBrowserWasm=true"/>
        <ProjectReference Include="../Fiberish.Core/Fiberish.Core.csproj" AdditionalProperties="FiberishForceBrowserWasm=true"/>
        <ProjectReference Include="../Fiberish.X86/Fiberish.X86.csproj" AdditionalProperties="FiberishForceBrowserWasm=true"/>
        <NativeFileReference Include="$(FibercpuWasmNativeDir)/libfibercpu.a"/>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="Podish.Core" RootMode="all"/>
        <TrimmerRootAssembly Include="Fiberish.Core" RootMode="all"/>
        <TrimmerRootAssembly Include="Fiberish.X86" RootMode="all"/>
    </ItemGroup>

    <Target Name="FrontendBuild" BeforeTargets="Build"
            Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'RelWithDebInfo'">
        <Message Importance="high" Text="Building frontend with Vite..."/>
        <Exec WorkingDirectory="frontend" Command="npm install"/>
        <Exec WorkingDirectory="frontend" Command="npm run build"/>
    </Target>

    <Target Name="CleanPublishWwwrootBeforePublish"
            BeforeTargets="ComputeFilesToPublish"
            Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
        <PropertyGroup>
            <_PublishWwwrootDir>$([MSBuild]::NormalizePath('$(PublishDir)', 'wwwroot'))</_PublishWwwrootDir>
            <_ProjectWwwrootDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'wwwroot'))</_ProjectWwwrootDir>
        </PropertyGroup>
        <Message Importance="high" Text="Cleaning publish wwwroot at $(_PublishWwwrootDir) before publish..."
                 Condition="'$(_PublishWwwrootDir)' != '' and '$(_PublishWwwrootDir)' != '$(_ProjectWwwrootDir)' and Exists('$(_PublishWwwrootDir)')"/>
        <RemoveDir Directories="$(_PublishWwwrootDir)"
                   Condition="'$(_PublishWwwrootDir)' != '' and '$(_PublishWwwrootDir)' != '$(_ProjectWwwrootDir)' and Exists('$(_PublishWwwrootDir)')"/>
    </Target>

</Project>
