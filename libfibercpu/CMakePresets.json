{
  "version": 2,
  "configurePresets": [
    {
      "name": "baking-release",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FIBERCPU_ENABLE_LLVM_JIT": false,
        "FIBERCPU_ENABLE_DYNAMIC_SPECIALIZATION": false
      }
    },
    {
      "name": "1.5m",
      "displayName": "1.5 MiB native text growth per guest",
      "inherits": "baking-release",
      "cacheVariables": { "FIBERCPU_BAKING_PRESET": "1.5m" }
    },
    {
      "name": "3m",
      "displayName": "3 MiB native text growth per guest",
      "inherits": "baking-release",
      "cacheVariables": { "FIBERCPU_BAKING_PRESET": "3m" }
    },
    {
      "name": "10m",
      "displayName": "10 MiB native text growth per guest",
      "inherits": "baking-release",
      "cacheVariables": { "FIBERCPU_BAKING_PRESET": "10m" }
    }
  ],
  "buildPresets": [
    { "name": "1.5m", "configurePreset": "1.5m", "targets": ["fibercpu"] },
    { "name": "3m", "configurePreset": "3m", "targets": ["fibercpu"] },
    { "name": "10m", "configurePreset": "10m", "targets": ["fibercpu"] }
  ]
}
