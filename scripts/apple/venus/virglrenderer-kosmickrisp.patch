+   atomic_init(&shm->references, 1);
+   shm->mapping = mapping;
+   shm->size = size;
+   shm->export_fd = exportable ? fd : -1;
+   return shm;
+}
+
+struct vkr_host_shm *
+vkr_host_shm_alloc(uint64_t size)
+{
+   if (!size || size > SIZE_MAX || size > INT64_MAX)
+      return NULL;
+
+   int fd = os_create_anonymous_file(size, "vkr-vulkan");
+   if (fd < 0)
+      return NULL;
+
+   struct vkr_host_shm *shm = vkr_host_shm_map(fd, size, true);
+   if (!shm)
+      close(fd);
+   return shm;
