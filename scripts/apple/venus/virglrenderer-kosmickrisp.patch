+static struct vkr_host_shm *
+vkr_host_shm_map(int fd, uint64_t size, bool exportable)
+{
+   if (!size || size > SIZE_MAX)
+      return NULL;
+
+   struct vkr_host_shm *shm = calloc(1, sizeof(*shm));
+   if (!shm)
+      return NULL;
