 void
+mtl_use_drawable_residency_set(mtl_command_buffer *command_buffer,
+                               void *drawable)
+{
+   @autoreleasepool {
+      id<MTL4CommandBuffer> cmd_buf = (id<MTL4CommandBuffer>)command_buffer;
+      id<CAMetalDrawable> metal_drawable = (id<CAMetalDrawable>)drawable;
+      id<MTLResidencySet> residency = metal_drawable.layer.residencySet;
+      if (residency)
+         [cmd_buf useResidencySet:residency];
+   }
+}
