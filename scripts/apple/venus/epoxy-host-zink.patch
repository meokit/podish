+/* The embedded renderer installs its Mesa GL resolver before creating any
+ * contexts. This prevents Darwin from finding Apple's OpenGL framework. */
+static void *(*podish_resolve_gl)(const char *);
+
+void podish_epoxy_set_gl_resolver(void *(*resolve)(const char *));
+void
+podish_epoxy_set_gl_resolver(void *(*resolve)(const char *))
+{
+    podish_resolve_gl = resolve;
+}
+
 void *
 epoxy_gl_dlsym(const char *name)
 {
+    if (podish_resolve_gl)
+        return podish_resolve_gl(name);
+
     epoxy_load_gl();
 
     return do_dlsym(&api.gl_handle, name, true);
