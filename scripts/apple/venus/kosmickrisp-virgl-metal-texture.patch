diff --git a/src/kosmickrisp/bridge/mtl_texture.m b/src/kosmickrisp/bridge/mtl_texture.m
index 496ce14..47a6c49 100644
--- a/src/kosmickrisp/bridge/mtl_texture.m
+++ b/src/kosmickrisp/bridge/mtl_texture.m
@@ -14,6 +14,33 @@

 #include <Metal/MTLTexture.h>

+mtl_heap *
+mtl_get_shared_texture_heap(mtl_texture *texture, mtl_device *device,
+                            uint32_t width, uint32_t height,
+                            uint32_t *vk_format)
+{
+   id<MTLTexture> tex = (id<MTLTexture>)texture;
+   if (tex.device != (id<MTLDevice>)device || tex.width != width ||
+       tex.height != height || tex.arrayLength != 1 || tex.sampleCount != 1 ||
+       !(tex.usage & MTLTextureUsageShaderRead) ||
+       (tex.textureType != MTLTextureType2D &&
+        tex.textureType != MTLTextureType2DArray))
+      return NULL;
+
+   switch (tex.pixelFormat) {
+   case MTLPixelFormatBGRA8Unorm:
+      *vk_format = VK_FORMAT_B8G8R8A8_UNORM;
+      break;
+   case MTLPixelFormatRGBA8Unorm:
+      *vk_format = VK_FORMAT_R8G8B8A8_UNORM;
+      break;
+   default:
+      return NULL;
+   }
+
+   return (mtl_heap *)tex.heap;
+}
