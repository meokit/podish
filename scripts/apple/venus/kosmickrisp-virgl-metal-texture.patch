+VKAPI_ATTR void *VKAPI_CALL
+kk_podish_get_metal_texture(VkImage handle)
+{
+   VK_FROM_HANDLE(kk_image, image, handle);
+   if (!image || image->plane_count != 1 ||
+       image->vk.image_type != VK_IMAGE_TYPE_2D ||
+       image->vk.samples != VK_SAMPLE_COUNT_1_BIT ||
+       !(image->vk.usage & VK_IMAGE_USAGE_SAMPLED_BIT))
+      return NULL;
+
+   /* The caller keeps the producer image alive until the consumer retains it. */
+   return image->planes[0].mtl_handle;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_podish_import_metal_texture(VkDevice device, void *texture, uint32_t width,
+                              uint32_t height, VkImage *handle, VkFormat *format)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   if (!texture || !width || !height || !dev->has_queue)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   uint32_t vk_format = VK_FORMAT_UNDEFINED;
+   mtl_heap *heap = mtl_get_shared_texture_heap(texture, dev->mtl_handle, width,
+                                               height, &vk_format);
+   if (!heap)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   const VkImageCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = vk_format,
+      .extent = {width, height, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_SAMPLED_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   VkResult result = kk_CreateImage(device, &info, NULL, handle);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VK_FROM_HANDLE(kk_image, image, *handle);
+   mtl_residency_set *residency = mtl_new_residency_set(dev->mtl_handle);
+   if (!residency) {
+      kk_DestroyImage(device, *handle, NULL);
+      *handle = VK_NULL_HANDLE;
+      return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   }
+
+   mtl_residency_set_add_allocation(residency, (mtl_allocation *)heap);
+   mtl_residency_set_commit(residency);
+   mtl_command_queue_add_residency_set(dev->queue.mtl_handle, residency);
+   image->imported_residency = residency;
+   image->planes[0].mtl_handle = mtl_retain(texture);
+   image->planes[0].addr = mtl_texture_get_gpu_resource_id(texture);
+   *format = vk_format;
+   return VK_SUCCESS;
+}
