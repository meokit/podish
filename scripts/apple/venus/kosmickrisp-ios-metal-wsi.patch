@@ -155,11 +155,17 @@
   gnu_symbol_visibility : 'hidden',
 )
 
+kk_platform_deps = []
+if host_machine.system() == 'darwin'
+  kk_platform_deps += dependency('appleframeworks', modules : ['CoreFoundation', 'CoreGraphics', 'Foundation'])
+endif
+
 # Happens with macOS ld linker:
 # "-Wl,-undefined,dynamic_lookup" required, otherwise, linker will complain about undefined symbols
